# Frontend environment (copy to .env)
# Leave BOTH blank to run in local demo mode (API auth, no Supabase browser auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only set if the API is on a different origin than the web app
VITE_API_BASE_URL=
# Display timezone for all dates (default Asia/Kolkata)
VITE_DISPLAY_TIMEZONE=Asia/Kolkata
