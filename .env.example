# ============================================================
# LeadFlow CRM - environment variables
# ============================================================
# Copy this file to .env (root) for the local API server.
# NEVER commit real secrets to Git.
#
# LOCAL DEV MODE:
# If SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are left EMPTY,
# the API runs in an explicit, isolated "local demo mode" using an
# in-memory store (clearly labelled in the UI). This is ONLY for
# interface testing - it is not connected to any real database.
# ------------------------------------------------------------

# --- Supabase (required for real data) ----------------------
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- App -----------------------------------------------------
# Base URL of the web app (used in emails/links)
APP_BASE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secret used to sign import preview payloads (local mode falls back automatically)
APP_SECRET=
# Node environment: development | production
NODE_ENV=development
# API port for local development
PORT=3001

# --- Frontend (Vite) - copy to frontend/.env for real Supabase auth
# (see frontend/.env.example) ---------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=
